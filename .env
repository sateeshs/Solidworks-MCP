# API settings for the LLM

# API key (example for OpenAI - must be replaced by the user with a real key)
LLM_API_KEY=your_api_key_here

# Provider type (openai, google, or openrouter)
LLM_PROVIDER=openai

# Model name
LLM_MODEL=gpt-3.5-turbo

